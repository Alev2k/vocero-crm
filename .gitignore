# --- Secretos (NUNCA al control de versiones) ---
.env
.env.*
!.env.example
*.pem
*.key

# --- MCP local (config específica de cada máquina/cliente) ---
# .mcp.json NO se versiona: cada agencia/dev lo arma localmente a partir de
# .mcp.json.example (que sí se versiona, con ${VAR} y sin secretos en claro).
.mcp.json

# --- Dependencias / build (cuando el starter ya tenga app encima) ---
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo

# --- Logs y temporales ---
*.log
npm-debug.log*
pnpm-debug.log*
.cache/
tmp/
.tmp/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# --- Claude Code: estado local (no compartir) ---
# La memoria de subagentes (.claude/agent-memory/) SÍ se versiona (es memoria de
# proyecto compartida con el equipo). La config local de la sesión, no:
.claude/settings.local.json
.playwright-mcp/
.tmp-seed-demo.mjs
